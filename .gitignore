# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Settings File
**/settings.json
/app/icons

# Environments
.env
.venv
env/
venv/

# uv
.python-version
pyproject.toml
uv.lock

# Throwaway test scripts written next to the code they poke at stay local.
# The committed suite lives in tests/ and is exempt.
test_*.py
!tests/test_*.py
demo_*.py
benchmarks/

# Scratch scripts stay local; committed maintenance scripts are listed explicitly.
scripts/*
!scripts/build_translations.py
!scripts/check_headless.py
!scripts/check_psd_in_photopea.py
